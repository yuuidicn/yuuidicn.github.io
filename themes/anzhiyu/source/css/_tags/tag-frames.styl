// Colorful framed tag styles — transparent backgrounds, colored borders
#tag-page-tags,
.post-meta__box__tag-list,
.post-meta__box
  a,
  a.post-meta__box__tags
    display inline-block
    margin 6px 10px
    padding 6px 12px
    border-radius 12px
    text-decoration none
    color var(--anzhiyu-fontcolor)
    font-weight 600
    font-size 14px
    line-height 1
    border 2px solid rgba(0,0,0,0.06)
    background transparent
    box-shadow 0 6px 18px rgba(0,0,0,0.04)
    transition all .18s ease
    vertical-align middle

    .tags-punctuation
      margin-right 6px
      opacity 0.95
      font-weight 700
      display inline-block

    .tagsPageCount
      margin-left 8px
      font-size 12px
      opacity 0.95
      background transparent
      padding 2px 6px
      border-radius 10px
      color var(--anzhiyu-fontcolor)

    &:hover
      transform translateY(-3px)
      box-shadow 0 12px 30px rgba(0,0,0,0.06)
      background rgba(255,255,255,0.02)

  // Palette variations — colored borders while keeping text color normal
  a:nth-child(6n+1)
    border-color #ff7eb3
    box-shadow 0 6px 18px rgba(255,126,179,0.06)

  a:nth-child(6n+2)
    border-color #4facfe
    box-shadow 0 6px 18px rgba(79,172,254,0.06)

  a:nth-child(6n+3)
    border-color #19547b
    box-shadow 0 6px 18px rgba(25,84,123,0.06)

  a:nth-child(6n+4)
    border-color #fbd786
    box-shadow 0 6px 18px rgba(251,215,134,0.06)

  a:nth-child(6n+5)
    border-color #fda085
    box-shadow 0 6px 18px rgba(253,160,133,0.06)

  a:nth-child(6n+6)
    border-color #a18cd1
    box-shadow 0 6px 18px rgba(161,140,209,0.06)

  // Responsive: wrap nicely on small screens
  @media (max-width: 480px)
    a
      padding 6px 10px
      font-size 13px
